@page
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Drum Tuner</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">🥁 Drum Tuner</div>
        <div class="nav-links">
            <button class="nav-btn active" data-page="selector">Select Drum</button>
            <button class="nav-btn" data-page="journal">Journal</button>
        </div>
    </nav>

    <main id="app">
        <!-- Content injected by JS -->
    </main>

    <script>
        // Initialize AudioContext on first user gesture (required by browsers)
        document.addEventListener('click', function initAudioOnce() {
            if (!window.tonePlayer || !window.tonePlayer.initAudio) return;
            window.tonePlayer.initAudio();
            document.removeEventListener('click', initAudioOnce);
        }, { once: true });
    </script>

    <script src="~/js/tone-player.js"></script>
    <script src="~/js/api-client.js"></script>
    <script src="~/js/drum-selector.js"></script>
    <script src="~/js/note-selector.js"></script>
    <script src="~/js/tuning-guide.js"></script>
    <script src="~/js/journal.js"></script>
    <script src="~/js/pitch-detector.js"></script>
    <script src="~/js/app.js"></script>
</body>
</html>
