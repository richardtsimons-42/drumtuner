@page
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="mobile-web-app-capable" content="yes" />
    <title>Instrument Tuner</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar">
        <div class="nav-brand">🎵 Tuner</div>
        <div class="nav-links">
            <button class="nav-btn active" data-page="selector">Instruments</button>
        </div>
    </nav>

    <main id="app">
        <!-- Content injected by JS -->
    </main>

    <script src="~/js/api-client.js"></script>
    <script src="~/js/instrument-selector.js"></script>
    <script src="~/js/drum-selector.js"></script>
    <script src="~/js/string-visualizer.js"></script>
    <script src="~/js/piano-visualizer.js"></script>
    <script src="~/js/note-selector.js"></script>
    <script src="~/js/tuning-guide.js"></script>
    <script src="~/js/pitch-detector.js"></script>
    <script src="~/js/app.js"></script>
</body>
</html>
